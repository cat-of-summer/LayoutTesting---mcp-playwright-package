INSTANCE=_layout
NETWORK=network
TRAEFIK_ENABLE=true
TRAEFIK_DOMAIN=layout.localhost
TRAEFIK_ENTRYPOINT=web
EXTERNAL_ACCESS=127.0.0.1:8089:80
HTTP_LOGIN=
HTTP_PASSWORD=
NGINX_CONF=playwright
DIST_PATH=artifacts
# Версии образов запечены: latest уходит вперёд молча, а стенд должен давать
# один и тот же результат на одном и том же коде.
NGINX_VERSION=1.29-alpine
# PLAYWRIGHT_VERSION обязан совпадать с версией пакета playwright в data/package.json:
# браузеры вшиты в образ и по другой версии не находятся.
PLAYWRIGHT_VERSION=v1.62.1-noble
# Playwright / MCP
PLAYWRIGHT_MODE=mcp
MCP_PORT=8931
MCP_ACCESS=127.0.0.1:8931:8931
# Внешние сервисы стенда
VNU_URL=http://vnu_layout:8888
# Публичная база для ссылок на артефакты в ответах MCP
PUBLIC_BASE_URL=http://127.0.0.1:8089
# Язык описаний инструментов MCP: ru | en | auto.
# Их читает модель, поэтому язык стоит выставлять по языку задач, а не интерфейса.
# auto смотрит на LANG/LC_ALL, но в контейнере там обычно C.UTF-8 — тогда берётся ru.
LT_LANG=ru
# Проверка обновлений стенда. LT_UPDATE_CHECK=0 выключает её целиком — для закрытых контуров,
# где запрос к GitHub всё равно упрётся в таймаут. Форкам: LT_UPDATE_REPO и LT_UPDATE_IMAGE.
LT_UPDATE_CHECK=1
# Figma. Секреты читает только стенд — агенту они не показываются.
# FIGMA_TOKEN — личный токен REST API со scopes только на чтение. Если его нет, а почта и пароль
# заданы, стенд выпустит токен сам; FIGMA_TOKEN_AUTOISSUE=0 это запрещает.
FIGMA_TOKEN=
FIGMA_EMAIL=
FIGMA_PASSWORD=
FIGMA_TOKEN_AUTOISSUE=1
# auto — входить в редактор Figma в браузере стенда, когда есть чем; off — только REST.
FIGMA_EDITOR=auto
# Имя состояния browser_storage, если вход в Figma уже сделан руками.
FIGMA_STORAGE_STATE=
