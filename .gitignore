.env
node_modules/
dist/
artifacts/*
!artifacts/.gitkeep

# Зеркала обходов: тяжёлые и воспроизводимые, в истории им делать нечего.
sites/*
!sites/.gitkeep

# Куки живых сессий, включая боевые логины. В git не попадают ни при каких условиях.
state/*
!state/.gitkeep
.update-check.json

# Снимки макетов Figma: воспроизводимы по ссылке, в истории им делать нечего.
figma/*
.figma-api-check.json
