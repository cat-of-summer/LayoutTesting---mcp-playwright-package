# Nu HTML Checker settings
# Последний версионированный тег в ghcr.io/validator/validator.
# latest уходит вперёд молча — на стенде это ломало бы воспроизводимость отчётов.
VNU_VERSION=24.10.17
# Container settings
INSTANCE=_layout
TRAEFIK_ENABLE=false
TRAEFIK_DOMAIN=vnu.localhost
TRAEFIK_ENTRYPOINT=web
NETWORK=network
# External container access
EXTERNAL_ACCESS=127.0.0.1:8888:8888
