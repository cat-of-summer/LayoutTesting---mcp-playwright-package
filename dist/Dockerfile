# Declared before the first FROM so that it is global. An ARG that follows a FROM belongs
# to that stage alone, and the base name of any later stage would then expand to nothing.
ARG BASE_IMAGE=mcr.microsoft.com/playwright:v1.62.1-noble

# A recipe takes named paths out of this image; nothing else from it enters the bundle.
FROM ghcr.io/validator/validator:24.10.17 AS img_ghcr_io_validator_validator_24_10_17

FROM ${BASE_IMAGE} AS bundle

ENV DEBIAN_FRONTEND=noninteractive \
    TZ=${TZ:-UTC} \
    SUPERVISOR_CONF=/etc/supervisord.conf

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates curl procps tini supervisor netcat-openbsd \
        nginx-light \
        gettext-base \
        openssl \
        iproute2 \
        fonts-noto-core \
        fonts-noto-color-emoji \
        fonts-noto-cjk \
        fonts-liberation \
        fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*
RUN rm -f /etc/nginx/sites-enabled/default

# ---- mcp_nginx (nginx) ----------------------------------
COPY context/mcp_nginx/configs /etc/nginx/configs
COPY context/mcp_nginx/entrypoint.sh /usr/local/bin/entrypoint-mcp_nginx.sh
RUN chmod 0755 /usr/local/bin/entrypoint-mcp_nginx.sh
RUN sed -i 's|proxy_pass http://playwright[^:]*:|proxy_pass http://127.0.0.1:|g' /etc/nginx/configs/nginx.playwright.conf

# ---- mcp_playwright (playwright) ------------------------
COPY context/mcp_playwright/package.json /var/www/html/package.json
COPY context/mcp_playwright/package-lock.json /var/www/html/package-lock.json
COPY context/mcp_playwright/src /var/www/html/src
COPY context/mcp_playwright/bin /var/www/html/bin
COPY context/mcp_playwright/fixtures /var/www/html/fixtures
COPY context/mcp_playwright/baselines /var/www/html/baselines
COPY context/mcp_playwright/matrix.example.json /var/www/html/matrix.example.json
RUN cd /var/www/html && PUPPETEER_SKIP_DOWNLOAD=1 PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=1 npm ci --omit=dev
RUN mkdir -p /var/www/html/artifacts /var/www/html/baselines
RUN ln -sf $(find /ms-playwright -type f -name chrome | head -1) /usr/local/bin/chrome-for-tools
RUN chmod +x /var/www/html/bin/lt.mjs && ln -sf /var/www/html/bin/lt.mjs /usr/local/bin/lt

# ---- vnu (vnu) ------------------------------------------
COPY --from=img_ghcr_io_validator_validator_24_10_17 /vnu-runtime-image /opt/vnu-runtime-image

COPY context/_bundle/supervisord.conf /etc/supervisord.conf
