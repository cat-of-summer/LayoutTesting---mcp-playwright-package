# Generated by dockerbundle 0.1.0. Do not edit; change bundle.yml and regenerate.
#
# Copy to .env and fill in. Values were merged from each source package's own
# .env.example; keys that collided were resolved as recorded in bundle.yml.

# ---- bundle ------------------------------------------------------------------
BUNDLE_IMAGE=ghcr.io/cat-of-summer/layouttesting---mcp-playwright-package:latest
INSTANCE=

# ---- global --------------------------------------------------------------------
NETWORK=network
TRAEFIK_ENTRYPOINT=web

# ---- shared --------------------------------------------------------------------
DIST_PATH=artifacts
HTTP_LOGIN=
HTTP_PASSWORD=
MCP_ACCESS=127.0.0.1:8931:8931
MCP_PORT=8931
NGINX_CONF=playwright
# Версии образов запечены: latest уходит вперёд молча, а стенд должен давать
# один и тот же результат на одном и том же коде.
NGINX_VERSION=1.29-alpine
# Playwright / MCP
PLAYWRIGHT_MODE=mcp
# PLAYWRIGHT_VERSION обязан совпадать с версией пакета playwright в data/package.json:
# браузеры вшиты в образ и по другой версии не находятся.
PLAYWRIGHT_VERSION=v1.62.1-noble
# Публичная база для ссылок на артефакты в ответах MCP
PUBLIC_BASE_URL=http://127.0.0.1:8089

# ---- manual --------------------------------------------------------------------
TRAEFIK_ENABLE=true
VNU_URL=http://127.0.0.1:8888

# ---- mcp_nginx -----------------------------------------------------------------
NGINX_EXTERNAL_ACCESS=127.0.0.1:8089:80
NGINX_TRAEFIK_DOMAIN=layout.localhost

# ---- mcp_playwright ------------------------------------------------------------
PLAYWRIGHT_EXTERNAL_ACCESS=127.0.0.1:8089:80
PLAYWRIGHT_TRAEFIK_DOMAIN=layout.localhost

# ---- vnu -----------------------------------------------------------------------
# External container access
VNU_EXTERNAL_ACCESS=127.0.0.1:8888:8888
VNU_TRAEFIK_DOMAIN=vnu.localhost
# Nu HTML Checker settings
# Последний версионированный тег в ghcr.io/validator/validator.
# latest уходит вперёд молча — на стенде это ломало бы воспроизводимость отчётов.
VNU_VERSION=24.10.17
